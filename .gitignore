# =============================================================
# .gitignore — Elezone WordPress Theme
# =============================================================
# این فایل در ریشه‌ی پروژه قرار دارد و کل مخزن (شامل wp-theme) را پوشش می‌دهد.
# قاعده: فایل‌های لازم برای اجرای قالب روی سرور باید در گیت باشند،
#        فایل‌های موقت/سیستمی/IDE باید نادیده گرفته شوند.
# =============================================================

# -------------------------------------------------------------
# ۱) سیستم‌عامل
# -------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -------------------------------------------------------------
# ۲) ادیتورها و IDEها
# -------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace
.history/

# PhpStorm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace
*.sublime-settings

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# -------------------------------------------------------------
# ۳) نسخه‌های پشتیبان و فایل‌های موقت
# -------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.rej
*.tmp
*.temp
*.log
*.cache
*.swp
*.swo

# -------------------------------------------------------------
# ۴) خروجی‌های build و zip
# -------------------------------------------------------------
# zipهای نهایی قالب
*.zip
!vendor/**/*.zip

# نقشه‌های source
*.map
!assets/Js/*.map

# فایل‌های build شده
/build/
/dist/

# -------------------------------------------------------------
# ۵) Node.js / npm (اگر بعداً اضافه شد)
# -------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
package-lock.json
!package-lock.json

# -------------------------------------------------------------
# ۶) Composer / PHP (اگر بعداً اضافه شد)
# -------------------------------------------------------------
/vendor/
composer.lock
!composer.lock
.phpunit.result.cache
.php_cs.cache

# -------------------------------------------------------------
# ۷) WordPress — اگر روزی کل نصب در گیت آمد
# -------------------------------------------------------------
# (این‌ها فعلاً وجود ندارند، اما محافظت پیشگیرانه)
wp-config.php
wp-config-local.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/debug.log
wp-admin/
wp-includes/
wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php

# -------------------------------------------------------------
# ۸) فایل‌های محیطی و حساس
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/

# -------------------------------------------------------------
# ۹) اطلاعات سیستم‌عامل و کش ابزارها
# -------------------------------------------------------------
.cache/
.sass-cache/
.eslintcache
.stylelintcache
.parcel-cache/

# -------------------------------------------------------------
# ۱۰) موقت‌های shell و ابزارها
# -------------------------------------------------------------
*.pid
*.seed
*.pid.lock

# -------------------------------------------------------------
# ✅ چیزهایی که عمداً ردیابی می‌شوند (نباید ignore شوند)
# -------------------------------------------------------------
# - assets/Css/*.css          ← استایل‌های قالب
# - assets/Js/*.js            ← اسکریپت‌های قالب (شامل init.js و customizer.js)
# - assets/Img/**             ← همه تصاویر
# - assets/Fonts/**           ← همه فونت‌ها (woff2, ttf, eot, woff, svg)
# - languages/fa_IR.po        ← فایل ترجمه‌ی منبع
# - languages/fa_IR.mo        ← فایل ترجمه‌ی کامپایل‌شده (بعداً ساخته می‌شود)
# - inc/starter-content*.php  ← نمونه‌های Starter Content
# - AGENT.md                  ← مستندات پروژه
# - README.md                 ← راهنمای نصب
# - screenshot.png            ← بعداً ساخته می‌شود

# -------------------------------------------------------------
# ۱۱) استثناها — حتی اگر بالا match شد، این‌ها ردیابی شوند
# -------------------------------------------------------------
# فایل‌های ضروری قالب که ممکن است با قاعده‌های بالا تصادفاً match شوند
!wp-theme/style.css
!wp-theme/functions.php
!wp-theme/languages/*.po
!wp-theme/languages/*.mo
!wp-theme/assets/Fonts/*

# فایل‌های vendor که باید کامیت شوند (در صورت وجود)
!vendor/autoload.php
